<UserControl x:Class="ME2LevelEditor.Views.HeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ME2LevelEditor.Converters">
    <UserControl.Resources>
        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="PropValue" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{StaticResource BgInput}" />
            <Setter Property="Foreground" Value="{StaticResource AccentCyan}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderMain}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentCyan}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="60" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0f1a30" Offset="0" />
                <GradientStop Color="#0d1525" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <DockPanel Height="42">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource Header_Version}" Style="{StaticResource PropLabel}" />
                    <TextBox Text="{Binding Header.Version, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PropValue}"
                             Width="48" />
                </StackPanel>
                <Rectangle Width="1" Height="20" Fill="{StaticResource BorderSubtle}" Margin="0,0,12,0" />
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource Header_Samples}" Style="{StaticResource PropLabel}" />
                    <TextBox Text="{Binding Header.TotalSamples, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PropValue}" />
                </StackPanel>
                <Rectangle Width="1" Height="20" Fill="{StaticResource BorderSubtle}" Margin="0,0,12,0" />
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource Header_DisplayBPM}" Style="{StaticResource PropLabel}" />
                    <TextBox Text="{Binding Header.DisplayBPM, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PropValue}" />
                </StackPanel>
                <Rectangle Width="1" Height="20" Fill="{StaticResource BorderSubtle}" Margin="0,0,12,0" />
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="BPM" Style="{StaticResource PropLabel}" />
                    <TextBox Text="{Binding Header.BPM, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PropValue}" />
                </StackPanel>
                <Rectangle Width="1" Height="20" Fill="{StaticResource BorderSubtle}" Margin="0,0,12,0" />
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource Header_Loudness}" Style="{StaticResource PropLabel}" />
                    <CheckBox IsChecked="{Binding Header.LoudnessCalculated}" VerticalAlignment="Center" Margin="4,0">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <Border x:Name="Bd" Width="14" Height="14" CornerRadius="3"
                                        Background="{StaticResource BgControl}" BorderBrush="{StaticResource BorderMain}" BorderThickness="1"
                                        SnapsToDevicePixels="True" VerticalAlignment="Center">
                                    <TextBlock x:Name="Check" Text="&#x2713;" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" Margin="0,-1,0,0" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentCyan}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding Header.IsLufsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Rectangle Width="1" Height="20" Fill="{StaticResource BorderSubtle}" Margin="0,0,12,0" />
                    <TextBlock Text="LUFS" Style="{StaticResource PropLabel}" />
                    <TextBox Text="{Binding Header.LoudnessLUFS, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PropValue}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="12,0,12,0">
                    <Rectangle Width="1" Height="20" Fill="{StaticResource BorderSubtle}" Margin="0,0,12,0" />
                    <TextBlock Text="{DynamicResource Header_Vol}" Style="{StaticResource PropLabel}" />
                    <Slider Width="80" Minimum="0" Maximum="1"
                        Value="{Binding Audio.Volume}"
                        VerticalAlignment="Center" Margin="4,0,4,0"
                        IsSnapToTickEnabled="False">
                        <Slider.Resources>
                            <Style TargetType="Thumb">
                                <Setter Property="Width" Value="10" />
                                <Setter Property="Height" Value="16" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource AccentCyan}" CornerRadius="3"
                                                BorderBrush="{StaticResource BorderMain}" BorderThickness="1" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="RepeatButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Slider.Resources>
                        <Slider.Template>
                            <ControlTemplate TargetType="Slider">
                                <Grid>
                                    <Border Height="4" CornerRadius="2" Background="{StaticResource BgInput}"
                                        BorderBrush="{StaticResource BorderMain}" BorderThickness="1"
                                        VerticalAlignment="Center" />
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Slider.Template>
                    </Slider>
                    <TextBlock Text="{Binding Audio.Volume, StringFormat={}{0:P0}}"
                           Foreground="{StaticResource AccentCyan}" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Width="32" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
