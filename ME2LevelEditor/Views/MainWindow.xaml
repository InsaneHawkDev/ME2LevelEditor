<Window x:Class="ME2LevelEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ME2LevelEditor.Views"
        xmlns:vm="clr-namespace:ME2LevelEditor.ViewModels"
        Title="{Binding WindowTitle}"
        Width="1400" Height="800"
        Background="{StaticResource BgDeep}"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Space" Command="{Binding PlayFromPlayheadCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveFileCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl+Shift" Command="{Binding ClearAllCommand}" />
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding SelectAllCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Timeline.SetToolCommand}" CommandParameter="{x:Static vm:ActiveTool.Pointer}" />
        <KeyBinding Key="D1" Command="{Binding Timeline.SetToolCommand}" CommandParameter="{x:Static vm:ActiveTool.PlaceZone}" />
        <KeyBinding Key="D2" Command="{Binding Timeline.SetToolCommand}" CommandParameter="{x:Static vm:ActiveTool.PlaceSolid}" />
        <KeyBinding Key="D3" Command="{Binding Timeline.SetToolCommand}" CommandParameter="{x:Static vm:ActiveTool.PlaceSolidHeld}" />
        <KeyBinding Key="D4" Command="{Binding Timeline.SetToolCommand}" CommandParameter="{x:Static vm:ActiveTool.PlaceSectionLow}" />
        <KeyBinding Key="D5" Command="{Binding Timeline.SetToolCommand}" CommandParameter="{x:Static vm:ActiveTool.PlaceSectionNormal}" />
        <KeyBinding Key="D6" Command="{Binding Timeline.SetToolCommand}" CommandParameter="{x:Static vm:ActiveTool.PlaceSectionHigh}" />
        <KeyBinding Key="D7" Command="{Binding Timeline.SetToolCommand}" CommandParameter="{x:Static vm:ActiveTool.PlaceSectionExtreme}" />
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding ZoomToFitCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <views:CustomTitleBar DockPanel.Dock="Top" />

        <Grid DockPanel.Dock="Top">

            <StackPanel>
                <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
                    <Menu Background="{StaticResource BgPanel}" Foreground="{StaticResource TextPrimary}">
                        <MenuItem Header="{DynamicResource Menu_File}">
                            <MenuItem Header="{DynamicResource Menu_Open}" Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O" />
                            <MenuItem Header="{DynamicResource Menu_Save}" Command="{Binding SaveFileCommand}" InputGestureText="Ctrl+S" />
                            <MenuItem Header="{DynamicResource Menu_SaveAs}" Command="{Binding SaveAsFileCommand}" />
                            <MenuItem Header="{DynamicResource Menu_ClearAll}" Command="{Binding ClearAllCommand}" InputGestureText="Ctrl+Shift+N" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="{DynamicResource Menu_LoadAudio}" Command="{Binding LoadAudioCommand}" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="{DynamicResource Menu_Quit}" Command="ApplicationCommands.Close" />
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Menu_View}">
                            <MenuItem Header="{DynamicResource Menu_ZoomToFit}" Command="{Binding ZoomToFitCommand}" InputGestureText="Ctrl+0" />
                        </MenuItem>
                        <MenuItem Header="{DynamicResource Menu_Edit}">
                            <MenuItem Header="{DynamicResource Menu_Undo}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                            <MenuItem Header="{DynamicResource Menu_Redo}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="{DynamicResource Menu_KeyMappings}" Click="OnOpenKeyMappings" />
                        </MenuItem>
                        <MenuItem x:Name="LanguageMenu" Header="{DynamicResource Menu_Language}" />
                        <MenuItem Header="{DynamicResource Menu_Help}">
                            <MenuItem Header="{DynamicResource Menu_About}" Click="OnOpenAbout" />
                        </MenuItem>
                    </Menu>
                </Border>
                <views:HeaderBar />
                <views:EditorToolBar />
            </StackPanel>
            <Image Source="/Assets/header.jpg"
                   Stretch="UniformToFill" VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Opacity="0.4"
                   RenderOptions.BitmapScalingMode="HighQuality" Height="115" HorizontalAlignment="Right" Width="242">
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="#60FFFFFF" Offset="0.5" />
                        <GradientStop Color="#FFFFFFFF" Offset="0.85" />
                        <GradientStop Color="#CCFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>
        </Grid>
        <views:SectionTrack DockPanel.Dock="Top" />
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
            <StatusBar Background="{StaticResource BgMain}" Padding="8,0">
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <DockPanel LastChildFill="False" />
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentCyan}" Margin="0,0,6,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{StaticResource AccentCyanColor}" BlurRadius="6" ShadowDepth="0" Opacity="0.5" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>
        </Border>
        <views:SelectionBar DockPanel.Dock="Bottom" />
        <views:TimelineView />
    </DockPanel>
</Window>
