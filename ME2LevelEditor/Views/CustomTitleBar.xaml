<UserControl x:Class="ME2LevelEditor.Views.CustomTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="30">
    <Border Background="{StaticResource BgDeep}" MouseLeftButtonDown="OnTitleBarMouseDown">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Click="OnMinimize"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE921;" FontSize="10" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Click="OnMaximize"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE922;" FontSize="10" />
                <Button Style="{StaticResource CloseButtonStyle}" Click="OnClose"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE8BB;" FontSize="10" />
            </StackPanel>
            <TextBlock x:Name="TitleText" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{StaticResource TextMuted}" FontSize="12"
                       IsHitTestVisible="False" />
        </DockPanel>
    </Border>
</UserControl>
