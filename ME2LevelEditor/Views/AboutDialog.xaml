<Window x:Class="ME2LevelEditor.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ME2LevelEditor.Views"
        Title="{DynamicResource About_Title}"
        Width="400" Height="300"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDeep}"
        ResizeMode="NoResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <DockPanel>
        <views:CustomTitleBar DockPanel.Dock="Top" ShowMaximize="False" ShowMinimize="False" />
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ME2 Level Editor" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="18" />
            <TextBlock x:Name="VersionText" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Foreground="{StaticResource TextPrimary}" FontSize="12" TextWrapping="Wrap">
                <Run Text="{DynamicResource About_CreatedBy}" /><Run Text=" InsaneHawk" Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="{DynamicResource About_Disclaimer}" />
            <TextBlock Margin="0,16,0,0" FontSize="12">
                <Hyperlink x:Name="RepoLink" NavigateUri="https://github.com/InsaneHawkDev/ME2LevelEditor" RequestNavigate="OnLinkNavigate"
                           Foreground="{StaticResource AccentCyan}" TextDecorations="Underline">
                    <Run Text="{DynamicResource About_GitHubLink}" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <Button Grid.Row="2" Content="{DynamicResource About_Close}" Padding="16,6" HorizontalAlignment="Right"
                Click="OnClose" />
    </Grid>
    </DockPanel>
</Window>
