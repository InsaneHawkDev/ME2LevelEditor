<Window x:Class="ME2LevelEditor.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ME2LevelEditor.Views"
        Title="{Binding DialogTitle}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDeep}"
        ResizeMode="NoResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <DockPanel>
        <views:CustomTitleBar DockPanel.Dock="Top" ShowMaximize="False" ShowMinimize="False" />
        <Grid Margin="24,16,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="MessageText" Grid.Row="0" Foreground="{StaticResource TextPrimary}"
                       FontSize="13" TextWrapping="Wrap" Margin="0,0,0,20" />

            <StackPanel x:Name="ButtonPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" />
        </Grid>
    </DockPanel>
</Window>
