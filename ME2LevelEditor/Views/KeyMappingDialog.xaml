<Window x:Class="ME2LevelEditor.Views.KeyMappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ME2LevelEditor.Views"
        Title="{DynamicResource KeyMap_Title}"
        Width="420" Height="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDeep}"
        ResizeMode="NoResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <DockPanel>
        <views:CustomTitleBar DockPanel.Dock="Top" ShowMaximize="False" ShowMinimize="False" />
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="#7fdbca" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"
                   Text="{DynamicResource KeyMap_Heading}" />
        <TextBlock Grid.Row="1" Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="{DynamicResource KeyMap_Instructions}" />

        <ItemsControl Grid.Row="2" x:Name="MappingsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding KeyName, Mode=OneWay}" IsReadOnly="True"
                                 Padding="6,4" Cursor="Hand" TextAlignment="Center"
                                 PreviewKeyDown="OnKeyBindingKeyDown" GotFocus="OnKeyBindingGotFocus"
                                 LostFocus="OnKeyBindingLostFocus" Tag="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource KeyMap_ResetDefaults}" Padding="12,6" Margin="0,0,8,0" Click="OnResetDefaults" />
            <Button Content="{DynamicResource KeyMap_Save}" Padding="12,6" Margin="0,0,8,0" Click="OnSave" />
            <Button Content="{DynamicResource KeyMap_Cancel}" Padding="12,6" Click="OnCancel" />
        </StackPanel>
    </Grid>
    </DockPanel>
</Window>
