<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menu: File -->
    <sys:String x:Key="Menu_File">_File</sys:String>
    <sys:String x:Key="Menu_Open">_Open</sys:String>
    <sys:String x:Key="Menu_Save">_Save</sys:String>
    <sys:String x:Key="Menu_SaveAs">Save _As...</sys:String>
    <sys:String x:Key="Menu_ClearAll">Clear _All Notes/Sections</sys:String>
    <sys:String x:Key="Menu_LoadAudio">_Load Audio</sys:String>
    <sys:String x:Key="Menu_Quit">_Quit</sys:String>

    <!-- Menu: View -->
    <sys:String x:Key="Menu_View">_View</sys:String>
    <sys:String x:Key="Menu_ZoomToFit">Zoom to _Fit</sys:String>

    <!-- Menu: Edit -->
    <sys:String x:Key="Menu_Edit">_Edit</sys:String>
    <sys:String x:Key="Menu_Undo">_Undo</sys:String>
    <sys:String x:Key="Menu_Redo">_Redo</sys:String>
    <sys:String x:Key="Menu_KeyMappings">_Key Mappings...</sys:String>

    <!-- Menu: Help -->
    <sys:String x:Key="Menu_Help">_Help</sys:String>
    <sys:String x:Key="Menu_About">_About...</sys:String>

    <!-- Menu: Language -->
    <sys:String x:Key="Menu_Language">_Language</sys:String>

    <!-- HeaderBar -->
    <sys:String x:Key="Header_Version">VERSION</sys:String>
    <sys:String x:Key="Header_Samples">SAMPLES</sys:String>
    <sys:String x:Key="Header_DisplayBPM">DISPLAY BPM</sys:String>
    <sys:String x:Key="Header_Loudness">LOUDNESS</sys:String>
    <sys:String x:Key="Header_Vol">VOL</sys:String>

    <!-- EditorToolBar: Transport -->
    <sys:String x:Key="Tool_Restart">Restart from beginning</sys:String>
    <sys:String x:Key="Tool_PlayPause">Play/Pause from playhead (Space)</sys:String>
    <sys:String x:Key="Tool_Stop">Stop</sys:String>

    <!-- EditorToolBar: Tools -->
    <sys:String x:Key="Tool_Pointer">Pointer</sys:String>
    <sys:String x:Key="Tool_PointerTip">Pointer (Esc)</sys:String>
    <sys:String x:Key="Tool_Zone">Zone</sys:String>
    <sys:String x:Key="Tool_ZoneTip">Zone obstacle (1)</sys:String>
    <sys:String x:Key="Tool_Solid">Solid</sys:String>
    <sys:String x:Key="Tool_SolidTip">Solid tap obstacle (2)</sys:String>
    <sys:String x:Key="Tool_Held">Held</sys:String>
    <sys:String x:Key="Tool_HeldTip">Solid held obstacle (3)</sys:String>

    <!-- EditorToolBar: Sections -->
    <sys:String x:Key="Tool_Low">Low</sys:String>
    <sys:String x:Key="Tool_LowTip">Low intensity section (4)</sys:String>
    <sys:String x:Key="Tool_Normal">Normal</sys:String>
    <sys:String x:Key="Tool_NormalTip">Normal intensity section (5)</sys:String>
    <sys:String x:Key="Tool_High">High</sys:String>
    <sys:String x:Key="Tool_HighTip">High intensity section (6)</sys:String>
    <sys:String x:Key="Tool_Extreme">Extreme</sys:String>
    <sys:String x:Key="Tool_ExtremeTip">Extreme intensity section (7)</sys:String>


    <!-- EditorToolBar: Other -->
    <sys:String x:Key="Tool_AutoRevertTip">Auto-revert to Pointer after placing an element</sys:String>
    <sys:String x:Key="Tool_AutoRevert">Auto &#x25B2;</sys:String>
    <sys:String x:Key="Tool_Zoom">Zoom: </sys:String>
    <sys:String x:Key="Tool_Sample"> | Sample: </sys:String>

    <!-- SelectionBar -->
    <sys:String x:Key="Sel_None">No selection</sys:String>
    <sys:String x:Key="Sel_Selection">SELECTION</sys:String>
    <sys:String x:Key="Sel_Type">Type:</sys:String>
    <sys:String x:Key="Sel_Sample">Sample:</sys:String>
    <sys:String x:Key="Sel_HeldDuration">Held Duration:</sys:String>
    <sys:String x:Key="Sel_Intensity">Intensity:</sys:String>
    <sys:String x:Key="Sel_Start">Start:</sys:String>
    <sys:String x:Key="Sel_Length">Length:</sys:String>
    <sys:String x:Key="Sel_AngelJump">Angel Jump:</sys:String>
    <sys:String x:Key="Sel_ItemsSelected"> items selected</sys:String>

    <!-- AboutDialog -->
    <sys:String x:Key="About_Title">About - ME2 Level Editor</sys:String>
    <sys:String x:Key="About_CreatedBy">Created by </sys:String>
    <sys:String x:Key="About_Disclaimer">This editor is an independent community tool and is not affiliated with, endorsed by, or connected to Loïc (Icetesy), the creator of Melody's Escape 2.</sys:String>
    <sys:String x:Key="About_GitHubLink">GitHub Repository</sys:String>
    <sys:String x:Key="About_Close">Close</sys:String>

    <!-- KeyMappingDialog -->
    <sys:String x:Key="KeyMap_Title">Key Mappings - Live Placement</sys:String>
    <sys:String x:Key="KeyMap_Heading">Live Placement Key Bindings</sys:String>
    <sys:String x:Key="KeyMap_Instructions">Press keys during playback to place elements at the playhead. Hold the Solid key to create a Held note. Click a key field and press a new key to rebind.</sys:String>
    <sys:String x:Key="KeyMap_ResetDefaults">Reset Defaults</sys:String>
    <sys:String x:Key="KeyMap_Save">Save</sys:String>
    <sys:String x:Key="KeyMap_Cancel">Cancel</sys:String>

    <!-- KeyMapping Display Names -->
    <sys:String x:Key="KeyMap_Zone">Zone</sys:String>
    <sys:String x:Key="KeyMap_SolidHeld">Solid / Solid Held</sys:String>
    <sys:String x:Key="KeyMap_SectionLow">Section Low</sys:String>
    <sys:String x:Key="KeyMap_SectionNormal">Section Normal</sys:String>
    <sys:String x:Key="KeyMap_SectionHigh">Section High</sys:String>
    <sys:String x:Key="KeyMap_SectionExtreme">Section Extreme</sys:String>

    <!-- Context Menu -->
    <sys:String x:Key="Ctx_Delete">Delete</sys:String>
    <sys:String x:Key="Ctx_ChangeToZone">Change to Zone</sys:String>
    <sys:String x:Key="Ctx_ChangeToSolid">Change to Solid</sys:String>
    <sys:String x:Key="Ctx_ChangeToHeld">Change to Solid Held</sys:String>
    <sys:String x:Key="Ctx_ChangeType">Change Type</sys:String>
    <sys:String x:Key="Ctx_AngelJump">Angel Jump</sys:String>

    <!-- MainViewModel messages -->
    <sys:String x:Key="Msg_ClearAllConfirm">Are you sure you want to delete all obstacles ({0}) and sections ({1}) from this level?

This action cannot be undone.</sys:String>
    <sys:String x:Key="Msg_ClearAllTitle">Clear All</sys:String>
    <sys:String x:Key="Msg_SaveChanges">Save changes?</sys:String>
    <sys:String x:Key="Msg_NoFile">No file</sys:String>
    <sys:String x:Key="Msg_Obstacles">Obstacles:</sys:String>
    <sys:String x:Key="Msg_Sections">Sections:</sys:String>
    <sys:String x:Key="Msg_Version">Version {0}.{1}.{2}</sys:String>
    <sys:String x:Key="Msg_LoadError">Failed to load the file.</sys:String>
    <sys:String x:Key="Msg_SaveError">Failed to save the file.</sys:String>

    <!-- Confirm Dialog Buttons -->
    <sys:String x:Key="Btn_Yes">Yes</sys:String>
    <sys:String x:Key="Btn_No">No</sys:String>
    <sys:String x:Key="Btn_Cancel">Cancel</sys:String>

    <!-- File Dialog Filters -->
    <sys:String x:Key="Filter_CacheFiles">Cache Files (*.txt)|*.txt|All Files (*.*)|*.*</sys:String>
    <sys:String x:Key="Filter_AudioFiles">Audio Files (*.mp3;*.wav;*.flac;*.ogg)|*.mp3;*.wav;*.flac;*.ogg|All Files (*.*)|*.*</sys:String>

</ResourceDictionary>
